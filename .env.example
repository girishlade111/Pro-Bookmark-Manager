# PostgreSQL Runtime Connection (Object Method)
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=

# PostgreSQL Schema Management (Drizzle Kit Admin)
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Single-Owner Immutable Auth User ID (Required for authorization)
# Set this to your immutable Auth User ID (UID) — never an email address.
BOOKMARK_OWNER_AUTH_USER_ID=your_immutable_owner_auth_uid_here

# Managed Auth / Google OAuth Configuration
NEON_AUTH_PROJECT_ID=
GOOGLE_CLIENT_ID=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
